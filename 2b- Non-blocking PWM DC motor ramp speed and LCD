/*
  Project: 02-Actuators-And-Sensors/02-DC-Motor-L298N-Speed-Control
  Feature:
  - Non-blocking PWM acceleration/deceleration ramp state machine
  - Non-blocking lcd refresh for telemetry
  Author: Harwell Mejia
  Tutor : GEMINI
  Date:　2026/08/21
  Hardware:
  - Arduino UNO
  - L293D Motor Driver + DC Motor
  - LCD 0X27 Size: 16x2
  - I2C lcd driver
  - Pins: ENA -> D3 (PWM), IN1 -> D4, IN2 -> D5
*/
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#define ENA_PIN 3
#define IN3_PIN 5
#define IN4_PIN 4

LiquidCrystal_I2C lcd(0x27, 16, 2);
//==Motor state parameters ==
int currentSpeed = 0;
int speedStep = 10;
const int speedInterval = 10;
const int minSpeed = 0;
const int maxSpeed = 255; //PWM DC voltage reading speed
bool isForward = true;

//== Non-blocking timer parameter ==
unsigned long lastStepTime = 0;
const unsigned long stepInterval = 20;

unsigned long lastLCDTime = 0;
const unsigned long lcdInterval = 50;

void setMotorDirection(bool forward){
  if(forward){
    digitalWrite(IN3_PIN, HIGH);
    digitalWrite(IN4_PIN, LOW);
  }
  else{
    digitalWrite(IN3_PIN, LOW);
    digitalWrite(IN4_PIN, HIGH);
  }
}

void setup(){
  Serial.begin(9600);
  pinMode(ENA_PIN, OUTPUT);
  pinMode(IN3_PIN, OUTPUT);
  pinMode(IN4_PIN, OUTPUT);
  
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0,0);
  lcd.print("Hi Arduino");
  
  analogWrite(ENA_PIN, currentSpeed);
  Serial.println("\nWelcome to Arduino - Non-blocking Series");
  Serial.println("By Harwell Mejia");
}

void loop(){
  //==Task 1 - Non-blocking PWM timer
  unsigned long currentStepTime = millis();
  if(currentStepTime - lastStepTime >= stepInterval){
    lastStepTime += stepInterval;
    
    currentSpeed = constrain(currentSpeed + speedStep, minSpeed, maxSpeed);
    analogWrite(ENA_PIN, currentSpeed);
    
    if(currentSpeed >= maxSpeed && speedStep > 0){
      currentSpeed = maxSpeed;
      speedStep = -speedInterval;
      Serial.println("Max speed Reached, Breaking...");
    }
    
    else if(currentSpeed <= minSpeed && speedStep < 0){
      currentSpeed = minSpeed;
      speedStep = speedInterval;
      isForward = !isForward;
      setMotorDirection(isForward);
      Serial.println("Min speed Reached, Reverse"); 
    }
    
    //==Telemetry==
    unsigned int currentRPM = (16500./255.)*currentSpeed;
    Serial.print("Speed: ");
    Serial.print(currentRPM);
    Serial.print("RPM");
    Serial.print(" | ");
    Serial.print("PWM: ");
    Serial.println(currentSpeed);
  }
  
  //==Task 2- Non- blocking LCD refresh
  unsigned long currentLCDTime = millis();
  if(currentLCDTime - lastLCDTime >= lcdInterval){
    lastLCDTime += lcdInterval;
    
    lcd.setCursor(0,0);
    if(isForward){
      lcd.print("Dir: Clockwise  ");
    }
    else{
      lcd.print("Dir: C-Clockwise");
    }
    
    //==Telemetry ==
    unsigned int currentRPM = (16500./255.)*currentSpeed;
    lcd.setCursor(0,1);
    lcd.print("RPM: ");
    lcd.print(currentRPM);
    lcd.print("   ");
  }
}
