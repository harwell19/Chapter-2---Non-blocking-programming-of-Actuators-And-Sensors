/*
  Project: 02-Actuators-And-Sensors/02-DC-Motor-L298N-Speed-Control
  Feature:
  - Non-blocking PWM acceleration/deceleration ramp state machine
  - Non-blocking lcd refresh for telemetry
  Author: Harwell Mejia
  Tutor : GEMINI
  Date:　2026/08/21
  Hardware:
  - Arduino UNO
  - L293D Motor Driver + DC Motor
  - LCD 0X27 Size: 16x2
  - I2C lcd driver
  - Pins: ENA -> D3 (PWM), IN1 -> D4, IN2 -> D5
*/
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#define ENA_PIN 3 //PWM Variable speed pin
#define IN3_PIN 5
#define IN4_PIN 4

LiquidCrystal_I2C lcd(0x27, 16, 2);

//==Motor speed state parameters
int currentSpeed = 0;
int speedStep = 5;
const int minSpeed = 0;
const int maxSpeed = 255;
bool isForward = true;

//==Non-blocking timer parameter
unsigned long lastRampTime = 0;
const unsigned long rampInterval = 30;

unsigned long lastLCDTime = 0;
const unsigned long lcdInterval = 50;

void setMotorDirection(bool forward){
  if(forward){
    analogWrite(ENA_PIN, currentSpeed);
    digitalWrite(IN3_PIN, HIGH);
    digitalWrite(IN4_PIN, LOW);
  }
  else{
    analogWrite(ENA_PIN, currentSpeed);
    digitalWrite(IN3_PIN, LOW);
    digitalWrite(IN4_PIN, HIGH);
  }
}

void setup(){
  Serial.begin(9600);
  pinMode(ENA_PIN, OUTPUT);
  pinMode(IN3_PIN, OUTPUT);
  pinMode(IN4_PIN, OUTPUT);
  lcd.init();
  lcd.backlight();
  
  setMotorDirection(isForward);
  analogWrite(ENA_PIN, currentSpeed);
  lcd.setCursor(0,0);
  lcd.print("Speed state");
  
  lcd.setCursor(13,0);
  lcd.print("PWM");
}

void loop(){
  unsigned long currentRampTime = millis();
  if(currentRampTime - lastRampTime >= rampInterval){
    lastRampTime += rampInterval;
    
    currentSpeed = constrain(currentSpeed + speedStep, minSpeed, maxSpeed);
    analogWrite(ENA_PIN, currentSpeed);
    
    if(currentSpeed >= maxSpeed){
      speedStep = -5;
      Serial.println("Max speed reached");
      lcd.setCursor(0,1);
      lcd.print("Max Speed");
    }
    else if(currentSpeed <= minSpeed){
      speedStep = 5;
      isForward = !isForward;
      setMotorDirection(isForward);
      Serial.println("Min speed reached");
      lcd.setCursor(0,1);
      lcd.print("Min Speed");
    }
  }
  unsigned long currentLCDTime = millis();
  if(currentLCDTime - lastLCDTime >= lcdInterval){
    lastLCDTime += lcdInterval;
    
    lcd.setCursor(13,1);
    lcd.print(currentSpeed);
    lcd.print("  ");
  }
}
