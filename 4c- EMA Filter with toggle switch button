  Date     : August 2026
  Toolchain: Arduino C++ (Tested & Simulated in Tinkercad)
  ===========================================================================

  DESCRIPTION / FEATURES:
  - Non-blocking ADC sampling & Exponential Moving Average (EMA) filtering
    to eliminate potentiometer signal noise.
  - Smooth dynamic PWM speed transition for DC motor speed control.
  - Independent non-blocking Serial telemetry stream (115200 baud).

  HARDWARE COMPONENTS:
  - 1x Arduino UNO
  - 1x L293D H-Bridge Motor Driver IC
  - 1x Push Button
  - 1x Standard DC Motor
  - 1x 10k Potentiometer (Linear)
  - 1x 9V Battery (External Motor Power)

  WIRING & PIN MAPPING:
  - Potentiometer : Signal -> A0 | VCC -> 5V | GND -> GND
  - L293D Driver  : ENA   -> Pin 5 (PWM Enable 1,2)
                    IN3   -> Pin 2 (Control Input 1)
                    IN4   -> Pin 3 (Control Input 2)
                    VCC1  -> Arduino 5V (Logic Power)
                    VCC2  -> 9V (+) Battery (Motor Power)
                    GND   -> Common GND (GND bridged with Arduino GND)
  - DC Motor      : Terminals -> L293D OUT1 & OUT2
  - Push Button			  -> PIN 6
  
  ===========================================================================
*/

#define POT_PIN A0
#define IN3_PIN 2
#define IN4_PIN 3
#define ENA_PIN 5
#define BTN_PIN 6
#define redPin 7
#define greenPin 8

bool systemState = LOW;
//==EMA Filter parameters and non-blocking timer==
float filteredValue = 0.0;
float rawValue = 0.0;
const float alpha = 0.25; //Smoothing factor
unsigned int motorPWM = 0;

unsigned long lastSampleTime = 0;
const unsigned long sampleInterval = 20;

//==Non-blocking Serial Telemetry==
unsigned long lastSerialTime = 0;
const unsigned long serialInterval = 200;

//==Non-blocking toggle switch
bool lastBTNRead = HIGH;
bool stableBTNState = HIGH;
unsigned long btnBounceTime = 0;
const unsigned long btnDebounceDelay = 50;

void setup(){
  Serial.begin(115200);
  pinMode(BTN_PIN, INPUT_PULLUP);
  pinMode(POT_PIN, INPUT);
  pinMode(ENA_PIN, OUTPUT);
  pinMode(IN3_PIN, OUTPUT);
  pinMode(IN4_PIN, OUTPUT);
  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  
  //Initial state
  rawValue = analogRead(POT_PIN);
  filteredValue = rawValue;
  
  digitalWrite(redPin, !systemState);
  digitalWrite(greenPin, systemState);
        
  //motor direction
  digitalWrite(IN3_PIN, HIGH);
  digitalWrite(IN4_PIN, LOW);
  
  //Telemetry
  Serial.println("\nWelcome to Arduino - State Machine");
  Serial.println("By Harwell Mejia");
  Serial.println("RPM  |  PWM  |  Filtered Val  | Raw Value");
}
void loop(){
  //===Task 1 - Non-blocking Toggle Switch
  bool currentBTNRead = digitalRead(BTN_PIN);
  //1.1 Detect electrical change
  if(currentBTNRead != lastBTNRead){
    lastBTNRead = currentBTNRead;
    btnBounceTime = millis();
  }
  //1.2 Check bounce time
  unsigned long currentBTNTime = millis();
  if(currentBTNTime - btnBounceTime >= btnDebounceDelay){
    //1.3 Check stable state
    if(currentBTNRead != stableBTNState){
      stableBTNState = currentBTNRead;
      //1.4 valid button press
      if(stableBTNState == LOW){
        systemState = !systemState;
        
        digitalWrite(greenPin, systemState);
        digitalWrite(redPin, !systemState);
        
        Serial.print("System : ");
        Serial.println(systemState? "ON":"OFF");
        
        if(systemState == HIGH){
          //Reset values when system HIGH
          lastSerialTime = currentBTNTime;
          lastSampleTime = currentBTNTime;
          rawValue = analogRead(POT_PIN);
          analogWrite(ENA_PIN, motorPWM);
        }
        else{
          //Motor stopped when system LOW
          motorPWM = 0;
          analogWrite(ENA_PIN, motorPWM);
        }
      }
    }
  }
  if(systemState == HIGH){
  //=== Task 2- Non-blocking EMA Filter and DC motor
    unsigned long currentSampleTime = millis();
    if(currentSampleTime - lastSampleTime >= sampleInterval){
      lastSampleTime += sampleInterval;
      
      rawValue = analogRead(POT_PIN);
      //Y[n] = (aX[n])+(1-a)Y[n+1]
      filteredValue = (alpha * rawValue) + (1.0f - alpha) * filteredValue;
      
      //Motor speed controlled by potentiometer filter
      motorPWM = (255. / 1023.) * filteredValue;
      analogWrite(ENA_PIN, motorPWM);
    }
    
    //==Task 2 - Non-blocking telemetry
    unsigned long currentSerialTime = millis();
    if(currentSerialTime - lastSerialTime >= serialInterval){
      lastSerialTime += serialInterval;
      
      unsigned int currentRPM = (16500.0f / 255.0f) * motorPWM;
      Serial.print(currentRPM);
      Serial.print("  |  ");
      Serial.print(motorPWM);
      Serial.print("  |  ");
      Serial.print(filteredValue);
      Serial.print("  |  ");
      Serial.println(rawValue);
    }
  }
}
