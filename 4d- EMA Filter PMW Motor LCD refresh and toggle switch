#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#define POT_PIN A0
#define IN3_PIN 2
#define IN4_PIN 3
#define ENA_PIN 5
#define BTN_PIN 6
#define redPin 7
#define greenPin 8

LiquidCrystal_I2C lcd(0x27, 16, 2);
bool systemState = LOW;

//==EMA Parameters and timer variables
//Y[n]= (aX[n])+(1-a)Y[n-1]
float filteredVal = 0.0;
float rawVal = 0.0;
const float alpha = 0.25; //Smoothing factor 0<a<1
unsigned int motorPWM = 0;

unsigned long lastSampleTime = 0;
const unsigned long sampleInterval = 25;

//==LCD Telemetry parameters==
unsigned long lastLCDTime = 0;
const unsigned long lcdInterval = 250;

//==Serial Telemetry parameters==
unsigned long lastSerialTime = 0;
const unsigned long serialInterval = 250;

//==Non-blocking toggle switch parameters==
bool lastBTNRead = HIGH;
bool stableBTNState =HIGH;
unsigned long btnBounceTime = 0;
const unsigned long btnDebounceDelay = 50;

void setup(){
  Serial.begin(115200);
  pinMode(BTN_PIN, INPUT_PULLUP);
  pinMode(POT_PIN, INPUT);
  pinMode(ENA_PIN, OUTPUT);
  pinMode(IN3_PIN, OUTPUT);
  pinMode(IN4_PIN, OUTPUT);
  pinMode(redPin, OUTPUT);
  pinMode(greenPin, OUTPUT);
  lcd.init();
  lcd.backlight();
    
  //Initial state
  rawVal = analogRead(POT_PIN);
  filteredVal = rawVal;
  
  digitalWrite(redPin, !systemState);
  digitalWrite(greenPin, systemState);
  
  //set motor direction
  digitalWrite(IN3_PIN, HIGH);
  digitalWrite(IN4_PIN, LOW);
  
  //Telemetry
  lcd.setCursor(0,0);
  lcd.print("Hi Arduino");
  
  Serial.println("\nWelcome to Arduino - State Machine");
  Serial.println("By Harwell");
  
  Serial.println("RPM  |  PWM  | Filtered Val | raw Val"); 
}

void loop(){
  //===Task 1 - Activate non-blocking toggle switch
  bool currentBTNRead = digitalRead(BTN_PIN);
  if(currentBTNRead != lastBTNRead){
    lastBTNRead = currentBTNRead;
    btnBounceTime = millis();
  }
  unsigned long currentBTNTime = millis();
  if(currentBTNTime - btnBounceTime >= btnDebounceDelay){
    
    if(currentBTNRead != stableBTNState){
      stableBTNState = currentBTNRead;
      
      if(stableBTNState == LOW){
        systemState = !systemState;
        digitalWrite(redPin, !systemState);
        digitalWrite(greenPin, systemState);
        Serial.print("System: ");
        Serial.println(systemState? "ON":"OFF");
        
        if(systemState == HIGH){
          lastSampleTime = currentBTNTime;
          lastLCDTime = currentBTNTime;
          lastSerialTime = currentBTNTime;
          rawVal = analogRead(POT_PIN);
          analogWrite(ENA_PIN, motorPWM);
        }
        else{
          motorPWM = 0;
          analogWrite(ENA_PIN, motorPWM);
          lcd.setCursor(0,0);
          lcd.print("System OFF  ");
          lcd.setCursor(0,1);
          lcd.print("             ");
        }
      }
    }
  }
    if(systemState == HIGH){
      //==Task 2 - non-blocking EMA Filter
      unsigned long currentSampleTime = millis();
      if(currentSampleTime - lastSampleTime >= sampleInterval){
        lastSampleTime += sampleInterval;
        
        rawVal = analogRead(POT_PIN);
        filteredVal = (alpha * rawVal) + (1.0f - alpha) * filteredVal;
        
        //Controlling motor speed
        motorPWM = (255./1023.) * filteredVal;
        analogWrite(ENA_PIN, motorPWM);
      }
      
      //==Task 3 - Non-blocking LCD refresh - telemetry
      unsigned long currentLCDTime = millis();
      if(currentLCDTime - lastLCDTime >= lcdInterval){
        lastLCDTime += lcdInterval;
        
        unsigned int currentSpeed = (16500./255.)* motorPWM;
        lcd.setCursor(0,0);
        lcd.print("RPM: ");
        lcd.print(currentSpeed);
        lcd.print("          ");
        
        lcd.setCursor(0,1);
        lcd.print("Pot Val: ");
        lcd.print((int)filteredVal);
        lcd.print("          ");
      }
      unsigned long currentSerialTime = millis();
      if(currentSerialTime - lastSerialTime >= serialInterval){
        lastSerialTime += serialInterval;
        
        unsigned int currentSpeed = (16500./255.)* motorPWM;
        Serial.print(currentSpeed);
        Serial.print("  |  ");
        Serial.print(motorPWM);
        Serial.print("  |  ");
        Serial.print((float)filteredVal);
        Serial.print("  |  ");
        Serial.println((unsigned int)rawVal);
      }
    }
  }
